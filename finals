import os # os is a built-in module that lets Python talk to the operating system
import time # time is a built-in module that lets Python pause for a while


# settings
LESSON_PASS_MARK = 2 # minimum score to pass the lessons
FINAL_PASS_MARK = 7 # minimum score to pass the final quiz


# helper functions
# screen basics
def clear_screen():             # def or define is how we create a function or a brand new command
    if os.name == "nt":         # "nt" means Windows
        os.system("cls")        # cls is the command to clear the screen in Windows
    else:
        os.system("clear")      # clear is the command to clear the screen in Linux and Mac


def pause(message="Press Enter to continue..."):
    input("\n" + message)       # message "parameter" or "placeholder"


def show_banner(text):          # show_banner function that prints a centered title box
    print("=" * 50)
    print(text.center(50))      # center() puts the text in the middle
    print("=" * 50)


# transitions
def transition_in(title, subtitle):
    """Title appears, then a line grows across the screen."""
    clear_screen()              # clear the screen before showing the title and subtitle
    print("\n" * 8)             # print 8 blank lines to push the title and subtitle down the screen
    print(title.center(50))     # center() puts the text in the middle of a 50-character wide line
    print(subtitle.center(50))  
    print()
    for length in range(0, 51, 2):                   # the line grows from 0 to 50, in steps of 2
        print("=" * length, end="\r", flush=True)    # flush=True shows it right away
        time.sleep(0.02)                             # pause before the next step
    time.sleep(0.5)                                  # pausebefore clearing the screen
    clear_screen()


def transition_out(message):    # transition_out function that shows a message and shrinks a line across the screen
    """A message appears, then the line shrinks away."""
    clear_screen()
    print("\n" * 8)
    print(message.center(50))
    print()
    time.sleep(0.5)
    for length in range(50, -1, -2):
        print("=" * length + " " * (50 - length), end="\r", flush=True)
        time.sleep(0.02)
    clear_screen()


# showing lessons and questions
def show_part(title, part, total_parts, lines):
    """Show one part of a lesson, line by line."""
    clear_screen()
    show_banner(title)
    print(f"Part {part} of {total_parts}\n")

    for line in lines:
        print(line)
        time.sleep(0.08)

    if part < total_parts:
        pause("Press Enter for the next part...")
    else:
        pause("Press Enter to continue to the quiz...")


def show_code(code, numbered):
    """Print code lines. Line numbers are shown when numbered is True."""
    line_number = 1
    for line in code:
        if numbered == True:
            print(f"   {line_number} | {line}")
        else:
            print(f"     {line}")
        line_number = line_number + 1
    print()


def show_question(number, label, question):
    clear_screen()
    print(f"QUESTION {number}   |   {label}")
    print("-" * 50)
    print()
    print(question)
    print()


# input checking
def has_letters(text):
    """True if the text has at least one letter in it."""
    for character in text:
        if character.isalpha():
            return True
    return False


def is_number_answer(text):
    """True if the text is made of numbers only (digits, spaces, commas, - and .)."""
    for character in text:
        if character not in "0123456789 ,.-":
            return False
    return True


def get_letter():
    """Keep asking until the learner types A, B or C."""
    letter = ""
    while letter not in ["a", "b", "c"]:
        # strip() removes extra spaces, lower() makes it a small letter
        letter = input("\nYour answer (A, B or C): ").strip().lower()

        if letter not in ["a", "b", "c"]:
            print("Invalid input. Please try again.")
    return letter


def get_typed_answer(prompt, correct):
    """Keep asking until the learner types a usable answer.
    If the right answer is numbers, the learner must type numbers.
    If the right answer is text, the learner must type text."""
    wants_number = is_number_answer(correct)

    while True:
        reply = input(prompt).strip()

        if reply != "" and is_number_answer(reply) == wants_number:
            return reply

        print("Invalid input. Please try again.")


def show_result(is_correct, right_answer, explain):
    if is_correct == True:
        print("\nCorrect!")
    else:
        print("\nNot quite. The answer is: " + right_answer)
    print(explain)
    pause()


# certificate
def space_out(text):
    """Put a space between the letters, for example PYTHON becomes P Y T H O N."""
    spaced = ""
    for letter in text:
        spaced = spaced + letter + " "
    return spaced.strip()


def make_certificate(name, score, date_text):
    """Draw the certificate in the terminal, line by line."""
    inner = 64                  # the width of the space inside the borders
    percent = score * 10

    # the name in capital letters, with spaces between the letters
    name_text = space_out(name.upper())
    if len(name_text) > inner - 4:          # too long? use the normal name
        name_text = name.upper()[:inner - 4]

    # the line under the name
    underline_length = len(name_text) + 6
    if underline_length > inner - 8:
        underline_length = inner - 8

    lines = [
        "",
        "*  *  *     " + space_out("PYTHON ZERO") + "     *  *  *",
        "",
        space_out("CERTIFICATE OF COMPLETION"),
        "─" * 30,
        "",
        "This certifies that",
        "",
        name_text,
        "═" * underline_length,
        "",
        "has successfully completed all seven lessons",
        "and passed the final quiz of",
        "",
        "PYTHON ZERO",
        "From Zero Knowledge to Coding Skills",
        "",
        "Introduction to Programming  *  Python Basic Syntax",
        "Arithmetic Operators and Expressions",
        "Basic Input and Output  *  Conditional Statements",
        "Logical Operators  *  Iteration and Loops",
        "",
        "─" * 30,
        "",
        f"Date: {date_text}",
        f"Final quiz score: {score} / 10  ({percent}%)",
        "",
        "*  *  *",
        "",
    ]

    clear_screen()
    print()
    print("╔" + "═" * (inner + 4) + "╗")
    print("║ ┌" + "─" * inner + "┐ ║")
    for line in lines:
        print("║ │" + line.center(inner) + "│ ║")      # center() puts the text in the middle
        time.sleep(0.05)
    print("║ └" + "─" * inner + "┘ ║")
    print("╚" + "═" * (inner + 4) + "╝")

    print("\nTip: take a screenshot to keep a copy of your certificate.")

# quizzes
# The four kinds of questions. Each one gives back True (right) or False (wrong).
def multiple_choice(number, label, question, code, a, b, c, answer, explain):
    """Used for concept checks and for 'find the error' questions."""
    show_question(number, label, question)
    if len(code) > 0:
        show_code(code, True)

    print("   A. " + a)
    print("   B. " + b)
    print("   C. " + c)
    letter = get_letter()

    # the text of the right answer, shown when the learner is wrong
    if answer == "a":
        right_text = "A. " + a
    elif answer == "b":
        right_text = "B. " + b
    else:
        right_text = "C. " + c

    is_correct = letter == answer
    show_result(is_correct, right_text, explain)
    return is_correct


def fix_error(number, question, code, correct, explain):
    """The learner types the corrected line."""
    show_question(number, "Fix the error", question)
    show_code(code, True)
    reply = get_typed_answer("Type the corrected line: ", correct)

    # ignore extra spaces, and treat ' and " as the same
    your_answer = reply.replace(" ", "").replace("'", '"')
    right_answer = correct.replace(" ", "").replace("'", '"')

    is_correct = your_answer == right_answer
    show_result(is_correct, correct, explain)
    return is_correct


def try_code(number, question, code, correct, explain):
    """The learner runs the code in their editor and types what it shows."""
    show_question(number, "Try it yourself", question)
    show_code(code, False)
    print("(Run the code yourself, then type what it shows.)")
    reply = get_typed_answer("\nYour answer: ", correct)

    # ignore spaces, commas and capital letters
    your_answer = reply.replace(" ", "").replace(",", "").lower()
    right_answer = correct.replace(" ", "").replace(",", "").lower()

    is_correct = your_answer == right_answer
    show_result(is_correct, correct, explain)
    return is_correct


# quiz introduction and results
def start_quiz(number, title):
    clear_screen()
    show_banner(f"QUIZ: LESSON {number}")
    print("\n" + title)
    print(f"\n3 questions. You need {LESSON_PASS_MARK} correct to pass.")
    print("Some questions ask you to find errors, fix code, or try code yourself,")
    print("so have your code editor open and ready.")
    pause("Press Enter to start the quiz...")


def finish_quiz(score):
    """Show the results. Gives back True if the learner passed."""
    clear_screen()
    show_banner("QUIZ RESULTS")
    print(f"\nYou scored {score} out of 3.")

    if score >= LESSON_PASS_MARK:
        print("\nYou passed this lesson!")
        passed = True
    else:
        print("\nNot enough to pass this time.")
        print("Read the lesson again and give it another try.")
        passed = False

    pause("Press Enter to go back to the menu...")
    transition_out("Returning to the menu...")
    return passed


